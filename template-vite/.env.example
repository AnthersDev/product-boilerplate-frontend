# Copy to `.env.local` and adjust (create-frontend does this for new projects). `.env.local` is gitignored.
# Only variables prefixed with VITE_ are exposed to the client bundle, and anyone using the site can read them.
# Never put secrets (API keys, tokens, passwords) here; keep them on the backend.

# Base URL for all API requests made through the shared axios client
VITE_API_BASE_URL=http://localhost:8080/api

# Request timeout in milliseconds
VITE_API_TIMEOUT_MS=15000

# App ID registered with the Marmeto identity service. Set it to show "Sign in with Google" on the login page.
# VITE_SSO_APP_ID=

# Mock API (src/services/mocks). Left unset, it is on for `npm run dev` and off for builds.
# Set to "false" to call VITE_API_BASE_URL while developing, or "true" to force mocks in a build.
# VITE_USE_MOCK_API=false

# Artificial latency (ms) applied to mocked responses
VITE_MOCK_API_DELAY_MS=300
